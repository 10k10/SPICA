* MUX507 - 36 V, 8:1 differential / dual 8:1 precision analog multiplexer (TI SBAS803A)
* LTspice model built for SPICA: NMOS || PMOS transmission gate (datasheet Fig 38), bodies at
* VSS / VDD, gates driven rail to rail; level-1 parameters fitted to the datasheet curves:
*   Ron vs VS         Fig 1, 3, 6, 8   +-5 V: 2.3 % rms, +-15 V: 8 % rms
*   Ron vs temp       Fig 4            2.9 .. 4.7 % rms, -40 .. 125 C
*   CS/CD(OFF), CD(ON) Fig 20, 24      3 .. 5 % rms
*   tON/tOFF/tt/tBBM  table (+-15 V)   81 / 63 / 92 / 42 ns vs 82 / 63 / 97 / 30..54 ns
*   charge injection  Fig 12           magnitude only (nominal ~0 pC; QK spreads it)
* Not modelled: leakage (1 pA typ, 10 nA max @85 C), ESD clamps, behaviour above ~10 MHz.
*
* Logic: TTL threshold 1.4 V referred to GND. EN = 0 -> all off. A2..A0 = k-1 -> SkA-DA and SkB-DB on.
*
* Instance parameters (nominal = default; the symbols carry uniform Monte Carlo defaults built
* from the datasheet as typ +- (max - typ)):
*   RONK   Ron scale of the whole part              typ 125 / max 170 ohm   -> 1 +- 0.36
*   MkA/MkB  per-switch Ron offset (fraction)       dRON typ 6 / max 9 ohm   -> +- 0.036 each
*   CKS    source-side capacitance scale            CS(OFF) 2.1 / 3.0 pF     -> 1 +- 0.43
*   CKD    drain-side capacitance scale             CD(OFF) 6.4 / 7.5 pF     -> 1 +- 0.17
*   QK     charge-injection imbalance, -1 .. 1      +-0.9 pC full range @+-15 V
*   TDON   EN/address -> gate on delay             tON  82 / 136 ns         -> 65n +- 54n
*   TDOFF  EN/address -> gate off delay            tOFF 63 /  78 ns         -> 31n +- 15n
*   TDA    extra address-decoder delay             tt   97 / 143 ns         -> 15n +- 46n (>= 0)
*   Break-before-make is enforced: on-delay >= off-delay + 22.5 ns (datasheet tBBM >= 30 ns).

* MUX507: pins in SOIC/TSSOP order without NC pins:
*   1 VDD, 2 DB, 4..11 S8B..S1B, 12 GND, 15 A2, 16 A1, 17 A0, 18 EN, 19..26 S1A..S8A, 27 VSS, 28 DA
.subckt MUX507 VDD DB S8B S7B S6B S5B S4B S3B S2B S1B GND A2 A1 A0 EN S1A S2A S3A S4A S5A S6A S7A S8A VSS DA
+ params: RONK=1 CKS=1 CKD=1 QK=0 TDON=65n TDOFF=31n TDA=15n TEDGE=5n
+ M1A=0 M1B=0 M2A=0 M2B=0 M3A=0 M3B=0 M4A=0 M4B=0 M5A=0 M5B=0 M6A=0 M6B=0 M7A=0 M7B=0 M8A=0 M8B=0
.param TDONE={max(TDON,TDOFF+22.5n)} TDAE={max(TDA,0)}
Ben en_l 0 V=V(EN,GND)>1.4
Ba0 a0_l 0 V=delay(V(A0,GND)>1.4,{TDAE})
Ba1 a1_l 0 V=delay(V(A1,GND)>1.4,{TDAE})
Ba2 a2_l 0 V=delay(V(A2,GND)>1.4,{TDAE})
Bsel1 sel1 0 V=V(en_l)>0.5 & !V(a2_l)>0.5 & !V(a1_l)>0.5 & !V(a0_l)>0.5
Bdly1 dly1 0 V=min(delay(V(sel1),{TDONE}),delay(V(sel1),{TDOFF}))
Rg1 dly1 ctl1 1k
Cg1 ctl1 0 {TEDGE/1k}
Bgn1 gn1 VSS V=(V(VDD)-V(VSS))*V(ctl1)
Bgp1 gp1 VDD V=-(V(VDD)-V(VSS))*V(ctl1)
XA1 S1A DA gn1 gp1 VDD VSS GND MUX507_SW params: RK={RONK*(1+M1A)} CKS={CKS} CKD={CKD} QK={QK}
XB1 S1B DB gn1 gp1 VDD VSS GND MUX507_SW params: RK={RONK*(1+M1B)} CKS={CKS} CKD={CKD} QK={QK}
Bsel2 sel2 0 V=V(en_l)>0.5 & !V(a2_l)>0.5 & !V(a1_l)>0.5 & V(a0_l)>0.5
Bdly2 dly2 0 V=min(delay(V(sel2),{TDONE}),delay(V(sel2),{TDOFF}))
Rg2 dly2 ctl2 1k
Cg2 ctl2 0 {TEDGE/1k}
Bgn2 gn2 VSS V=(V(VDD)-V(VSS))*V(ctl2)
Bgp2 gp2 VDD V=-(V(VDD)-V(VSS))*V(ctl2)
XA2 S2A DA gn2 gp2 VDD VSS GND MUX507_SW params: RK={RONK*(1+M2A)} CKS={CKS} CKD={CKD} QK={QK}
XB2 S2B DB gn2 gp2 VDD VSS GND MUX507_SW params: RK={RONK*(1+M2B)} CKS={CKS} CKD={CKD} QK={QK}
Bsel3 sel3 0 V=V(en_l)>0.5 & !V(a2_l)>0.5 & V(a1_l)>0.5 & !V(a0_l)>0.5
Bdly3 dly3 0 V=min(delay(V(sel3),{TDONE}),delay(V(sel3),{TDOFF}))
Rg3 dly3 ctl3 1k
Cg3 ctl3 0 {TEDGE/1k}
Bgn3 gn3 VSS V=(V(VDD)-V(VSS))*V(ctl3)
Bgp3 gp3 VDD V=-(V(VDD)-V(VSS))*V(ctl3)
XA3 S3A DA gn3 gp3 VDD VSS GND MUX507_SW params: RK={RONK*(1+M3A)} CKS={CKS} CKD={CKD} QK={QK}
XB3 S3B DB gn3 gp3 VDD VSS GND MUX507_SW params: RK={RONK*(1+M3B)} CKS={CKS} CKD={CKD} QK={QK}
Bsel4 sel4 0 V=V(en_l)>0.5 & !V(a2_l)>0.5 & V(a1_l)>0.5 & V(a0_l)>0.5
Bdly4 dly4 0 V=min(delay(V(sel4),{TDONE}),delay(V(sel4),{TDOFF}))
Rg4 dly4 ctl4 1k
Cg4 ctl4 0 {TEDGE/1k}
Bgn4 gn4 VSS V=(V(VDD)-V(VSS))*V(ctl4)
Bgp4 gp4 VDD V=-(V(VDD)-V(VSS))*V(ctl4)
XA4 S4A DA gn4 gp4 VDD VSS GND MUX507_SW params: RK={RONK*(1+M4A)} CKS={CKS} CKD={CKD} QK={QK}
XB4 S4B DB gn4 gp4 VDD VSS GND MUX507_SW params: RK={RONK*(1+M4B)} CKS={CKS} CKD={CKD} QK={QK}
Bsel5 sel5 0 V=V(en_l)>0.5 & V(a2_l)>0.5 & !V(a1_l)>0.5 & !V(a0_l)>0.5
Bdly5 dly5 0 V=min(delay(V(sel5),{TDONE}),delay(V(sel5),{TDOFF}))
Rg5 dly5 ctl5 1k
Cg5 ctl5 0 {TEDGE/1k}
Bgn5 gn5 VSS V=(V(VDD)-V(VSS))*V(ctl5)
Bgp5 gp5 VDD V=-(V(VDD)-V(VSS))*V(ctl5)
XA5 S5A DA gn5 gp5 VDD VSS GND MUX507_SW params: RK={RONK*(1+M5A)} CKS={CKS} CKD={CKD} QK={QK}
XB5 S5B DB gn5 gp5 VDD VSS GND MUX507_SW params: RK={RONK*(1+M5B)} CKS={CKS} CKD={CKD} QK={QK}
Bsel6 sel6 0 V=V(en_l)>0.5 & V(a2_l)>0.5 & !V(a1_l)>0.5 & V(a0_l)>0.5
Bdly6 dly6 0 V=min(delay(V(sel6),{TDONE}),delay(V(sel6),{TDOFF}))
Rg6 dly6 ctl6 1k
Cg6 ctl6 0 {TEDGE/1k}
Bgn6 gn6 VSS V=(V(VDD)-V(VSS))*V(ctl6)
Bgp6 gp6 VDD V=-(V(VDD)-V(VSS))*V(ctl6)
XA6 S6A DA gn6 gp6 VDD VSS GND MUX507_SW params: RK={RONK*(1+M6A)} CKS={CKS} CKD={CKD} QK={QK}
XB6 S6B DB gn6 gp6 VDD VSS GND MUX507_SW params: RK={RONK*(1+M6B)} CKS={CKS} CKD={CKD} QK={QK}
Bsel7 sel7 0 V=V(en_l)>0.5 & V(a2_l)>0.5 & V(a1_l)>0.5 & !V(a0_l)>0.5
Bdly7 dly7 0 V=min(delay(V(sel7),{TDONE}),delay(V(sel7),{TDOFF}))
Rg7 dly7 ctl7 1k
Cg7 ctl7 0 {TEDGE/1k}
Bgn7 gn7 VSS V=(V(VDD)-V(VSS))*V(ctl7)
Bgp7 gp7 VDD V=-(V(VDD)-V(VSS))*V(ctl7)
XA7 S7A DA gn7 gp7 VDD VSS GND MUX507_SW params: RK={RONK*(1+M7A)} CKS={CKS} CKD={CKD} QK={QK}
XB7 S7B DB gn7 gp7 VDD VSS GND MUX507_SW params: RK={RONK*(1+M7B)} CKS={CKS} CKD={CKD} QK={QK}
Bsel8 sel8 0 V=V(en_l)>0.5 & V(a2_l)>0.5 & V(a1_l)>0.5 & V(a0_l)>0.5
Bdly8 dly8 0 V=min(delay(V(sel8),{TDONE}),delay(V(sel8),{TDOFF}))
Rg8 dly8 ctl8 1k
Cg8 ctl8 0 {TEDGE/1k}
Bgn8 gn8 VSS V=(V(VDD)-V(VSS))*V(ctl8)
Bgp8 gp8 VDD V=-(V(VDD)-V(VSS))*V(ctl8)
XA8 S8A DA gn8 gp8 VDD VSS GND MUX507_SW params: RK={RONK*(1+M8A)} CKS={CKS} CKD={CKD} QK={QK}
XB8 S8B DB gn8 gp8 VDD VSS GND MUX507_SW params: RK={RONK*(1+M8B)} CKS={CKS} CKD={CKD} QK={QK}
* supply current (45 uA VDD, 26 uA VSS typ)
IqA VDD GND 19u
IqB VDD VSS 26u
.ends MUX507

* MUX507_2CH: channels 1 and 2 of the same part. A0 = 0 -> S1A-DA, S1B-DB; A0 = 1 -> S2A-DA, S2B-DB; EN = 0 -> off.
.subckt MUX507_2CH VDD VSS GND EN A0 S1A S2A S1B S2B DA DB
+ params: RONK=1 CKS=1 CKD=1 QK=0 TDON=65n TDOFF=31n TDA=15n TEDGE=5n
+ M1A=0 M1B=0 M2A=0 M2B=0
.param TDONE={max(TDON,TDOFF+22.5n)} TDAE={max(TDA,0)}
Ben en_l 0 V=V(EN,GND)>1.4
Ba0 a0_l 0 V=delay(V(A0,GND)>1.4,{TDAE})
Bsel1 sel1 0 V=V(en_l)>0.5 & !V(a0_l)>0.5
Bdly1 dly1 0 V=min(delay(V(sel1),{TDONE}),delay(V(sel1),{TDOFF}))
Rg1 dly1 ctl1 1k
Cg1 ctl1 0 {TEDGE/1k}
Bgn1 gn1 VSS V=(V(VDD)-V(VSS))*V(ctl1)
Bgp1 gp1 VDD V=-(V(VDD)-V(VSS))*V(ctl1)
XA1 S1A DA gn1 gp1 VDD VSS GND MUX507_SW params: RK={RONK*(1+M1A)} CKS={CKS} CKD={CKD} QK={QK}
XB1 S1B DB gn1 gp1 VDD VSS GND MUX507_SW params: RK={RONK*(1+M1B)} CKS={CKS} CKD={CKD} QK={QK}
Bsel2 sel2 0 V=V(en_l)>0.5 & V(a0_l)>0.5
Bdly2 dly2 0 V=min(delay(V(sel2),{TDONE}),delay(V(sel2),{TDOFF}))
Rg2 dly2 ctl2 1k
Cg2 ctl2 0 {TEDGE/1k}
Bgn2 gn2 VSS V=(V(VDD)-V(VSS))*V(ctl2)
Bgp2 gp2 VDD V=-(V(VDD)-V(VSS))*V(ctl2)
XA2 S2A DA gn2 gp2 VDD VSS GND MUX507_SW params: RK={RONK*(1+M2A)} CKS={CKS} CKD={CKD} QK={QK}
XB2 S2B DB gn2 gp2 VDD VSS GND MUX507_SW params: RK={RONK*(1+M2B)} CKS={CKS} CKD={CKD} QK={QK}
XA3 GND DA VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XB3 GND DB VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XA4 GND DA VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XB4 GND DB VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XA5 GND DA VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XB5 GND DB VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XA6 GND DA VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XB6 GND DB VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XA7 GND DA VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XB7 GND DB VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XA8 GND DA VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
XB8 GND DB VSS VDD VDD VSS GND MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
* supply current (45 uA VDD, 26 uA VSS typ)
IqA VDD GND 19u
IqB VDD VSS 26u
.ends MUX507_2CH

* MUX507_2TO1: one 2:1 switch of the same part. EN = 0 -> S0-D, EN = 1 -> S1-D (one channel always on).
* EN is the chip A0 (TTL 1.4 V vs ground, chip EN tied high): tt / tBBM timing. GND is node 0.
.subckt MUX507_2TO1 VCC VSS EN S0 S1 D
+ params: RONK=1 CKS=1 CKD=1 QK=0 TDON=65n TDOFF=31n TDA=15n TEDGE=5n M0=0 M1=0
.param TDONE={max(TDON,TDOFF+22.5n)} TDAE={max(TDA,0)}
Ba0 a0_l 0 V=delay(V(EN)>1.4,{TDAE})
Bsel1 sel1 0 V=!V(a0_l)>0.5
Bdly1 dly1 0 V=min(delay(V(sel1),{TDONE}),delay(V(sel1),{TDOFF}))
Rg1 dly1 ctl1 1k
Cg1 ctl1 0 {TEDGE/1k}
Bgn1 gn1 VSS V=(V(VCC)-V(VSS))*V(ctl1)
Bgp1 gp1 VCC V=-(V(VCC)-V(VSS))*V(ctl1)
X1 S0 D gn1 gp1 VCC VSS 0 MUX507_SW params: RK={RONK*(1+M0)} CKS={CKS} CKD={CKD} QK={QK}
Bsel2 sel2 0 V=V(a0_l)>0.5
Bdly2 dly2 0 V=min(delay(V(sel2),{TDONE}),delay(V(sel2),{TDOFF}))
Rg2 dly2 ctl2 1k
Cg2 ctl2 0 {TEDGE/1k}
Bgn2 gn2 VSS V=(V(VCC)-V(VSS))*V(ctl2)
Bgp2 gp2 VCC V=-(V(VCC)-V(VSS))*V(ctl2)
X2 S1 D gn2 gp2 VCC VSS 0 MUX507_SW params: RK={RONK*(1+M1)} CKS={CKS} CKD={CKD} QK={QK}
X3 0 D VSS VCC VCC VSS 0 MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
X4 0 D VSS VCC VCC VSS 0 MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
X5 0 D VSS VCC VCC VSS 0 MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
X6 0 D VSS VCC VCC VSS 0 MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
X7 0 D VSS VCC VCC VSS 0 MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
X8 0 D VSS VCC VCC VSS 0 MUX507_SW params: RK={RONK} CKS={CKS} CKD={CKD} QK=0
* supply current (45 uA VCC, 26 uA VSS typ)
IqA VCC 0 19u
IqB VCC VSS 26u
.ends MUX507_2TO1

* one switch: pad cap on S, series metal/well resistance, NMOS || PMOS, injection trim caps
.subckt MUX507_SW S D GN GP VDD VSS GND params: RK=1 CKS=1 CKD=1 QK=0
Cpad S GND {0.433p*CKS}
Rs S s1 {42.95*RK} tc=0.0056,2.6e-5
Rd D d1 {42.95*RK} tc=0.0056,2.6e-5
MN d1 GN s1 VSS MUX507_N W={109.34u/RK} L=2.0u AD={3.615e-10*CKD} AS={4.696e-10*CKS}
MP d1 GP s1 VDD MUX507_P W={104.35u/RK} L=2.0u AD={1.486e-09*CKD} AS={3.159e-09*CKS}
Cqp GP d1 {3e-14*max(QK,0)+1e-18}
Cqn GN d1 {3e-14*max(-QK,0)+1e-18}
.ends MUX507_SW

.model MUX507_N NMOS(level=1 VTO=1.2686 GAMMA=1.2376 PHI=0.3 KP=2e-05 TOX=1.687e-05 CGSO=2.663e-10 CGDO=2.663e-10 CJ=0.001 PB=0.1991 MJ=0.2134 TNOM=25)
.model MUX507_P PMOS(level=1 VTO=-1.0446 GAMMA=2.3541 PHI=0.3 KP=2e-05 TOX=0.0001011 CGSO=2.626e-10 CGDO=2.626e-10 CJ=0.001 PB=0.1991 MJ=0.2134 TNOM=25)

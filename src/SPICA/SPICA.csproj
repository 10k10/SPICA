<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SPICA</AssemblyName>
    <RootNamespace>Spica</RootNamespace>
    <ApplicationIcon>Resources\spica.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.0</Version>
    <Product>SPICA - Spice Parallel Instancer Circuit Analysis</Product>
    <Copyright>SPICA project</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\*.png" />
  </ItemGroup>

  <!-- Release: the distributable carries its version in the file name (dist\SPICA-0.3.0.exe).
       Settings stay in SPICA.ini / SPICA.profiles, so versions side by side share them. -->
  <Target Name="CopyVersionedExe" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(SkipDist)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildThisFileDirectory)..\..\dist\SPICA-$(Version).exe" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="SPICA $(Version) -> dist\SPICA-$(Version).exe" />
  </Target>

</Project>

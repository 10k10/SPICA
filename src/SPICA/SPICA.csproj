<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SPICA</AssemblyName>
    <RootNamespace>Spica</RootNamespace>
    <ApplicationIcon>Resources\spica.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>SPICA - Simulation Platform for Investigation, Compliance and Analysis</Product>
    <AssemblyTitle>SPICA - Simulation Platform for Investigation, Compliance and Analysis</AssemblyTitle>
    <Description>Studies of a circuit on LTspice (tolerance, worst case, qualification), run as parallel batch instances.</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\*.png" />
    <!-- the engine, compiled in so that SPICA.exe stays a single file -->
    <Compile Include="..\SPICA.Engine\**\*.cs" Exclude="..\SPICA.Engine\obj\**;..\SPICA.Engine\bin\**" Link="Engine\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Release: the distributable carries its version in the file name (dist\SPICA-0.3.0.exe).
       Settings stay in SPICA.ini / SPICA.profiles, so versions side by side share them. -->
  <Target Name="CopyVersionedExe" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(SkipDist)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildThisFileDirectory)..\..\dist\SPICA-$(Version).exe" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="SPICA $(Version) -> dist\SPICA-$(Version).exe" />
  </Target>

</Project>

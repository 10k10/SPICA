<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine: netlist, LTspice, campaigns, queue, listener, results, statistics and the study graphs.
       No window code: this project builds without WinForms, which keeps it so. SPICA.exe and SPICA-cli.exe
       compile these files in (each stays a single exe); this build is the check. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SPICA.Engine</AssemblyName>
    <RootNamespace>Spica.Core</RootNamespace>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>

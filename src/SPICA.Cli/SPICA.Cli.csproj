<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPICA without a window: the same engine (src/SPICA.Engine, compiled in), driven from the command line -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- the settings files are found next to the exe through Application.ExecutablePath -->
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SPICA-cli</AssemblyName>
    <RootNamespace>Spica</RootNamespace>
    <ApplicationIcon>..\SPICA\Resources\spica.ico</ApplicationIcon>
    <ApplicationManifest>..\SPICA\app.manifest</ApplicationManifest>
    <Product>SPICA - Simulation Platform for Investigation, Compliance and Analysis (command line)</Product>
    <AssemblyTitle>SPICA - Simulation Platform for Investigation, Compliance and Analysis (command line)</AssemblyTitle>
    <Description>Runs LTspice Monte Carlo campaigns from the command line, and watches a folder for campaigns.</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <DebugType>none</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Compile Include="..\SPICA.Engine\**\*.cs" Exclude="..\SPICA.Engine\obj\**;..\SPICA.Engine\bin\**" Link="Engine\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyVersionedExe" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(SkipDist)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildThisFileDirectory)..\..\dist\SPICA-cli-$(Version).exe" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="SPICA-cli $(Version) -> dist\SPICA-cli-$(Version).exe" />
  </Target>

</Project>
